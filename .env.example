# Copy to .env and fill in. Never commit the real .env.
HOST=0.0.0.0
PORT=3334
# AI provider (OpenAI-compatible). Pick one:
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Optional login gate (both must match what clients send):
AUTH_TOKEN=
# Exec tool (Debian sandbox per snippet; finalized exec environment):
EXEC_ENABLED=0
EXEC_MODE=sandbox
EXEC_ALLOW=python3,node,bash
SANDBOX_IMAGE=cvm-sandbox:debian
SANDBOX_TIMEOUT=30
SANDBOX_MEM=256m
SANDBOX_CPUS=0.5
SANDBOX_NET=none
# Build it: docker build -f Dockerfile.sandbox -t cvm-sandbox:debian .
# SpacetimeDB (data plane; creds stay server-side):
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=osintdb
SPACETIME_TOKEN=
# History retention (days; 0 = keep forever). Perpetual system defaults:
# living-page versions age out after 1 year, graph snapshots after 3 years.
PAGE_HISTORY_DAYS=365
GRAPH_HISTORY_DAYS=1095
# Feature-request forum email (every post/vote-milestone notifies):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cvm@localhost
FEATURE_NOTIFY_TO=
