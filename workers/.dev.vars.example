# Local dev vars for `wrangler dev` (auto-loaded, never commit the real one).
# Generated from the repo-root .env by `bash start.sh edge`
# (or copy this file to .dev.vars and fill in).
# Same keys as .env — one codebase, local or remote.
MODEL_API_KEY=
AI_BASE_URL=https://api.meta.ai/v1
AI_MODEL=muse-spark-1.3
AUTH_TOKEN=
# Sync server #2 (SpacetimeDB live writes). Same as [vars] in wrangler.toml.
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=osintdb
# SPACETIME_TOKEN=  (only if the database requires auth)
