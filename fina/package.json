{
  "name": "fina-console",
  "private": true,
  "version": "0.1.0",
  "description": "FINA production console: TLS + auth + rate limits in front of a SpacetimeDB module. Live module updates via scripts/deploy.sh.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js --format=esm --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-dist && esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-dist --out-extension:.js=.mjs && node --test .test-dist",
    "certs": "bash scripts/gen-certs.sh",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:build": "npm --prefix spacetimedb run build",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2"
  }
}
