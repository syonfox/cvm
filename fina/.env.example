# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The console refuses to start without AUTH_TOKEN (fail-closed auth).

# Required: bearer token clients must send as X-Auth-Token.
AUTH_TOKEN=change-me-to-a-long-random-string

# SpacetimeDB host this console proxies to. Credentials stay server-side.
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=finadb
SPACETIME_TOKEN=

# OpenAI-compatible LLM endpoint for the agent loop.
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=LLM_1905244147121938_JUbvMZU-M5rl_JHyz3Lc6yQQioY
AI_MODEL=muse-spark-1.3

# Exec tool: OFF by default. Only enable on trusted networks, and even
# then prefer EXEC_ALLOW="python3 -c ..." style prefix allowlists.
EXEC_ENABLED=0
EXEC_ALLOW=python3 -c,node -e
EXEC_TIMEOUT_SECS=15
EXEC_MAX_OUT=4000

PORT=8443
HOST=127.0.0.1
RATE_LIMIT_PER_MIN=60
BODY_MAX_BYTES=1048576
