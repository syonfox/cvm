[Unit]
Description=CVM (Cache Variable Memory) graph backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/cvm
EnvironmentFile=/opt/cvm/.env
ExecStart=/usr/bin/python3 backend/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
